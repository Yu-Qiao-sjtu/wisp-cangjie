{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:distill:schemas:semantic-map.schema.json",
  "title": "Distill Semantic Map (books/<slug>/semantic-map.md 内嵌 YAML)",
  "type": "object",
  "required": ["schema_version", "source_id", "mode", "nodes"],
  "properties": {
    "schema_version": { "const": 1 },
    "source_id": { "type": "string", "pattern": "^src-[a-z0-9-]+$", "description": "对应 .distill/manifest.yaml 的 source_id" },
    "mode": { "enum": ["book", "paper"] },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "statement", "status", "source_anchor"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(c|e|r|a|b)[0-9]{2,}$",
            "description": "类型缩写 + 序号: c=claim, e=evidence, r=reasoning, a=assumption, b=boundary"
          },
          "type": { "enum": ["claim", "evidence", "reasoning", "assumption", "boundary"] },
          "statement": { "type": "string", "minLength": 1, "description": "一句话陈述（主张 / 证据 / 推理 / 假设 / 边界）" },
          "status": {
            "enum": ["explicit", "inferred", "missing"],
            "description": "explicit=原文明确; inferred=由原文可推断; missing=缺口待补(不虚报零缺口)"
          },
          "source_anchor": {
            "type": "object",
            "required": ["location"],
            "properties": {
              "location": { "type": "string", "minLength": 1, "description": "可回查位置: 章节 / 页码 / 时间戳 / 图表编号" },
              "quote": { "type": "string", "maxLength": 150, "description": "原文引用 ≤150 字(英文 ≤100 词); status=missing 时可为空" }
            }
          },
          "links": {
            "type": "array",
            "description": "指向其他节点的关系边",
            "items": {
              "type": "object",
              "required": ["to", "relation"],
              "properties": {
                "to": { "type": "string", "pattern": "^(c|e|r|a|b)[0-9]{2,}$" },
                "relation": { "enum": ["supports", "derives", "qualifies", "contradicts", "elaborates"] }
              }
            }
          },
          "task_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^task-[0-9]+$" },
            "description": "映射阶段 0 原书关键任务清单"
          }
        }
      }
    }
  }
}
